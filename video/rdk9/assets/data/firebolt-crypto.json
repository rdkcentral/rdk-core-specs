            }
          ],
          "rows": [
            {
              "term": "enum",
              "meaning": "an instance of a type that can have one of a pre-defined set of values. Typically represented by a string in JSON-RPC, but an integer in C++"
            },
            {
              "term": "list of",
              "meaning": "an ordered collection of values"
            },
            {
              "term": "list of... unordered",
              "meaning": "an unordered collection of values"
            },
            {
              "term": "one of",
              "meaning": "an instance of a primitive type, such as unsigned or string, that can have one of a pre-defined set of values. Not an enum"
            },
            {
              "term": "monotonic",
              "meaning": "a numeric value that is greater than the last instance of that attribute"
            },
            {
              "term": "generic error",
              "meaning": "an error that can be returned by any method call, documented in the Errors section"
            },
            {
              "term": "specific error",
              "meaning": "an error that can be returned by specific methods, documented along with the method"
            }
          ]
        }
      ]
