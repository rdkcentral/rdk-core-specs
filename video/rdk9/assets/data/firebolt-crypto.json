    "api-6": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "flushKeys",
      "support": [
        {
          "label": "C++",
          "state": "supported"
        },
        {
          "label": "JS",
          "state": "not-supported"
        }
      ],
      "fields": [
        {
          "label": "Parameters",
          "value": "None"
        },
