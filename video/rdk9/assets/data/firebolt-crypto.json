    "api-10": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "verify",
      "support": [
        {
          "label": "C++",
          "state": "supported"
        },
        {
          "label": "JS",
          "state": "not-supported"
        }
      ],
      "fields": [
        {
          "label": "Parameters",
          "value": {
            "type": "list",
            "items": [
              {
                "text": "algorithm - enum",
                "items": [
                  "HMAC"
                ]
              },
              "keyId - unsigned (Reference to the loaded key)",
              {
                "text": "digestAlgorithm - enum",
                "items": [
                  "SHA256"
                ]
              },
              "inputDataOffset - unsigned",
              "inputDataLength - unsigned",
              "expectedSignatureOffset - unsigned",
              "expectedSignatureLength - unsigned"
            ]
          }
        },
        {
          "label": "Returns",
          "value": "bool - verification status"
        },
        {
          "label": "Specific errors",
          "value": {
            "type": "list",
            "items": [
              "-xxxxx / Invalid key",
              "-xxxxd / Invalid key type",
              "-xxxxy / Session to be reinitialized"
            ]
          }
        }
      ],
      "overview": "Calculate the MAC / signature value and verifies if the expected signature matches. Returns true if verification is successful or returns false. keyId shall match with a loaded key compatible with the selected algorithm. Examples: - HMAC: secret symmetric key",
      "trailing": []
    },
    "api-11": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "encrypt",
      "support": [
