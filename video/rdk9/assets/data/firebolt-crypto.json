    "api-7": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "importKey",
      "support": [
        {
          "label": "C++",
          "state": "supported"
        },
        {
          "label": "JS",
          "state": "not-supported"
        }
      ],
      "fields": [
        {
          "label": "Parameters",
          "value": {
            "type": "list",
            "items": [
              {
                "text": "keyType - enum",
                "items": [
                  "PUBLIC",
                  "PRIVATE",
                  "SYMMETRIC"
                ]
              },
              {
                "text": "Import/Export Type",
                "items": [
                  "Protected",
                  "Clear"
                ]
              },
              "Key blob to be imported - device-bound, integrity-protected, confidentiality-protected blob"
            ]
          }
        },
        {
          "label": "Returns",
          "value": "keyId - unsigned (Reference to the loaded key)"
        },
        {
          "label": "Specific errors",
          "value": "-xxxxk - Key Provision Error"
        }
      ],
      "overview": "Load the exported key material from the same device / platform into the key store. Verifies integrity and device binding before creating a key Rejects corrupted or foreign-device blobs Does not create a partially usable key on failure May return a different key ID from the original",
      "trailing": []
    },
    "api-8": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "exportKey",
      "support": [
        {
          "label": "C++",
          "state": "supported"
        },
        {
          "label": "JS",
          "state": "not-supported"
        }
      ],
      "fields": [
        {
          "label": "Parameters",
          "value": {
            "type": "list",
            "items": [
              "keyId - unsigned",
              {
                "text": "Import/Export Type - enum",
                "items": [
                  "Protected",
                  "Clear"
                ]
              }
            ]
          }
        },
        {
          "label": "Returns",
          "value": "keyBlob - list of unsigned, ordered."
        },
        {
          "label": "Specific errors",
          "value": {
            "type": "list",
            "items": [
              "-xxxxm - Sealed Key Cannot Export Error",
              "-xxxxe - Invalid key"
            ]
          }
        }
      ],
      "overview": "Exports the key material for usage by the platform after an import. Protected export shall preserve key material and all platform key metadata required to restore equivalent key behavior. The returned blob shall be device-bound, integrity-protected, and confidentiality-protected.",
      "trailing": []
    },
