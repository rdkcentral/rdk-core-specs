    "api-0": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "generateKey",
      "support": [
        {
          "label": "C++",
          "state": "supported"
        },
        {
          "label": "JS",
          "state": "not-supported"
        }
      ],
      "fields": [
        {
          "label": "Parameters",
          "value": {
            "type": "list",
            "items": [
              {
                "text": "keyParam - enum",
                "items": [
                  "AES128",
                  "AES256",
                  "HMAC128",
                  "HMAC160",
                  "HMAC256"
                ]
              },
              {
                "text": "keyUsage - list of enums, unordered - optional",
                "items": [
                  "ENCRYPT",
                  "DECRYPT",
                  "SIGN",
                  "VERIFY",
                  "DERIVE",
                  "WRAP",
                  "UNWRAP"
                ]
              }
            ]
          }
        },
        {
          "label": "Returns",
          "value": "keyId - unsigned"
        },
        {
          "label": "Specific errors",
          "value": {
            "type": "list",
            "items": [
              "-xxxxa - Key Creation Error",
              "-xxxxe - Invalid File name",
              "-xxxxd - Invalid key type"
            ]
          }
        }
      ],
      "overview": "Generate symmetric algorithm key file, load it into key store and provide handle for further access. Generated key this way shall be considered local to the application generating it - shall not be shared. Not persisted during this call. To use exportKey in case persistence is required. If keyUsage is omitted, the platform will assume all keyUsages corresponding to the keyParam.",
      "trailing": []
    },
    "api-1": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "generateKeyPair",
      "support": [
        {
          "label": "C++",
          "state": "supported"
        },
        {
          "label": "JS",
          "state": "not-supported"
        }
      ],
      "fields": [
        {
          "label": "Parameters",
          "value": {
            "type": "list",
            "items": [
              {
                "text": "algorithm - enum",
                "items": [
                  "AUTH_DH"
                ]
              },
              {
                "text": "Optional parameter for AUTH_DH algo:",
                "items": [
                  "primePDataOffset - unsigned",
                  "primePDataLength - unsigned",
                  "generatorGDataOffset - unsigned",
                  "generatorGDataLength - unsigned"
                ]
              },
              {
                "text": "Optional parameter for RSA algo (not supported, just for ex):",
                "items": [
                  "modulusBits - unsigned",
                  "publicExponent - unsigned"
                ]
              }
            ]
          }
        },
        {
          "label": "Returns",
          "value": {
            "type": "list",
            "items": [
              "privateKeyId - unsigned",
              "publicKeyId - unsigned"
            ]
          }
        },
        {
          "label": "Specific errors",
          "value": "None"
        }
      ],
      "overview": "Generates an ephemeral or application-scoped Diffie-Hellman public /private key pair for subsequent AUTH_DH derivation. Mapping from Netflix APIs: generatorG; // from base_buf primeP; // from modulus",
      "trailing": []
    },
    "api-2": {
      "type": "apiMethod",
