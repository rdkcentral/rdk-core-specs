            {
              "part": "appId",
              "type": "string",
              "mandatory": "yes",
              "description": "The App Id of the App associated with the Metrics",
              "allowedValues": "Any"
            },
            {
              "part": "fireboltMethod",
              "type": "string",
              "mandatory": "yes",
              "description": "The Firebolt Metrics method",
              "allowedValues": "Any Firebolt Metrics method name"
            },
            {
              "part": "environment",
              "type": "string",
              "mandatory": "no",
              "description": "The type of environment the metrics originated from",
              "allowedValues": {
                "type": "list",
                "items": [
                  "\"prod\"",
                  "\"test\"",
                  "\"dev\""
