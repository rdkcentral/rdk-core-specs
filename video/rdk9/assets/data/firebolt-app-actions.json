        {
          "type": "heading",
          "body": "Example"
        },
        {
          "type": "examples",
          "blocks": [
            {
              "type": "code",
              "body": "{                                                                            \n          \"actionType\": \"org.rdk.app.metrics.send\",                                 \n          \"actionData\": {                                                           \n                 \"appId\": \"hayu\",                                                   \n                 \"fireboltMethod\": \"Metrics.error\",                                 \n                 \"environment\": \"prod\",                                             \n                 \"timestamp\": 1785308400011,                                        \n                  \"payload\": {                                                      \n                       \"type\":\"media\",                                              \n                       \"code\":\"17904\",                                              \n                       \"description\": \"Media not found\",                            \n                       \"visible\": true,                                             \n                       \"agePolicy\": \"app:child\"                                     \n                 }                                                                  \n          }                                                                         \n       }",
