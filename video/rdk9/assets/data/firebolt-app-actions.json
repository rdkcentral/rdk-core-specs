    "app-action-2": {
      "type": "entry",
      "eyebrow": "App Action",
      "heading": "Send App WatchHistory",
      "overview": "App action type org.rdk.app.watchhistory.send.",
      "blocks": [
        {
          "type": "heading",
          "body": "Definition of action data"
        },
        {
          "type": "table",
          "columns": [
            {
              "key": "part",
              "label": "Part"
            },
            {
              "key": "type",
              "label": "Type"
            },
            {
              "key": "mandatory",
              "label": "Mandatory"
            },
            {
              "key": "description",
              "label": "Description"
            },
            {
              "key": "allowedValues",
              "label": "Allowed values"
            }
          ],
          "rows": [
            {
              "part": "appId",
              "type": "string",
              "mandatory": "yes",
              "description": "The App Id of the App associated with the watched history",
              "allowedValues": "Any"
            },
            {
              "part": "entityId",
              "type": "string",
              "mandatory": "yes",
              "description": "The entity Id of the watched content.",
              "allowedValues": "Any"
            },
            {
              "part": "progress",
              "type": "number",
              "mandatory": "no",
              "description": "How much of the content has been watched (percentage as (0-0.999) for VOD, number of seconds for live) minumum: 0",
              "allowedValues": "Any"
            },
            {
              "part": "completed",
              "type": "boolean",
              "mandatory": "no",
              "description": "Whether or not this viewing is considered “complete,” per the app’s definition thereof",
              "allowedValues": "Any"
            },
            {
              "part": "watchedOn",
              "type": "string",
              "mandatory": "no",
              "description": "Whether or not this viewing is considered “complete,” per the app’s definition thereof",
              "allowedValues": "Any"
            },
            {
              "part": "agePolicy",
              "type": "string",
              "mandatory": "no",
              "description": "An age policy of the user watching the content",
              "allowedValues": "app:child app:teen app:adult"
            }
          ]
        },
        {
          "type": "heading",
          "body": "Example"
        },
        {
          "type": "examples",
          "blocks": [
            {
              "type": "code",
              "body": "{                                                                            \n          \"actionType\": \"org.rdk.app.watchhistory.send\",                            \n          \"actionData\": {                                                           \n                 \"appId\": \"iPlayer\",                                                \n                   \"entityId\": \"abc1234xzy\",                                        \n                   \"progress\": 0.95,                                                \n                   \"completed\": true,                                               \n                   \"watchedOn\": \"2026-06-23T18:25:43.511Z\",                         \n                   \"agePolicy\": \"app:child\"                                         \n            }                                                                       \n       }",
              "variant": "spec-example"
            }
          ]
        }
      ]
    },
