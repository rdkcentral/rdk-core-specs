    "app-action-0": {
      "type": "entry",
      "eyebrow": "App Action",
      "heading": "Launch App",
      "overview": "App action type org.rdk.app.launch.",
      "blocks": [
        {
          "type": "heading",
          "body": "Definition of action data"
        },
        {
          "type": "table",
          "columns": [
            {
              "key": "part",
              "label": "Part"
            },
            {
              "key": "type",
              "label": "Type"
            },
            {
              "key": "mandatory",
              "label": "Mandatory"
            },
            {
              "key": "description",
              "label": "Description"
            },
            {
              "key": "allowedValues",
              "label": "Allowed values"
            }
          ],
          "rows": [
            {
              "part": "appId",
              "type": "string",
              "mandatory": "yes",
              "description": "The AppId of the app to launch",
              "allowedValues": "Any"
            },
            {
              "part": "intent",
              "type": "object",
              "mandatory": "yes",
              "description": "The intent to send to the App without the \"context\" object",
              "allowedValues": "A valid intent object without the \"context\" object"
            }
          ]
        },
        {
          "type": "heading",
          "body": "Example"
        },
        {
          "type": "examples",
          "blocks": [
            {
              "type": "code",
              "body": "{                                                                            \n          \"actionType\": \"org.rdk.app.launch\",                                       \n          \"actionData\": {                                                           \n            \"appId\": \"BBCSounds\",                                                   \n                 \"intent\": {                                                        \n               \"action\": \"entity\",                                                  \n               \"data\": {                                                            \n                 \"entityId\": \"ABC123\"                                               \n               }                                                                    \n            }                                                                       \n          },                                                                        \n          \"actionContext\": \"{\\\"schema\\\":\\\"campaign/1.0\\\",\\\"payload\\\":{\\\"campaign_id\\\":\\\"123456\\\",\\\"placement_id\\\":\\\"\n       12390113146247302414\\\",\\\"asset_id\\\":\\\"12049621954250482415\\\"}}\"              \n       }",
              "variant": "spec-example"
            }
          ]
        }
      ]
    },
    "app-action-1": {
      "type": "entry",
      "eyebrow": "App Action",
      "heading": "Send App Metrics",
