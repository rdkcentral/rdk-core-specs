        {
          "type": "examples",
          "blocks": [
            {
              "type": "code",
              "body": "{                                                                            \n          \"actionType\": \"org.rdk.dab.request\",                                      \n          \"actionData\": {                                                           \n                   \"topic\": \"applications/install\",                                 \n                   \"correlationData\": \"abc123\",                                     \n                   \"payload\": {                                                     \n                        \"appId\": \"YouTube\",                                         \n                        \"url\": \"http://192.168.2.108/app/youtube\",                  \n                        \"format\": \"wgt\"                                             \n                 }                                                                  \n          }                                                                         \n       }",
